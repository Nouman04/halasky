<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flight Invoice - <%= invoiceNumber %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #203f9c;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        .text-primary {
            color: var(--primary-color);
        }

        .hover\:text-primary:hover {
            color: var(--primary-color);
        }

        @page {
            margin-top: 15mm;
        }

        @page :first {
            margin-top: 0;
        }

        @media print {
            body {
                background-color: white;
            }

            .no-print {
                display: none;
            }

            /* Optimize for PDF/Printing */
            .page-break {
                page-break-after: always;
            }

            .content-card {
                break-inside: avoid;
            }

            .print-bg-force {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>

<body class="p-4 md:p-8">
    <!-- Main Invoice Container -->
    <div class="max-w-4xl mx-auto">

        <!-- Invoice Header -->
        <header class="bg-white shadow-sm">
            <div class="container mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center">
                    <img src="https://readdy.ai/api/search-image?query=Halasky%20travel%20logo%20with%20blue%20text%20and%20yellow%20accent%2C%20professional%20travel%20company%20logo%2C%20minimalist%20design%2C%20white%20background&width=200&height=60&seq=1&orientation=landscape"
                        alt="Halasky Logo" class="h-10">
                </div>
            </div>
        </header>

        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6 p-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div class="mb-4 md:mb-0">
                    <h1 class="text-2xl font-bold text-gray-900 mb-1">INVOICE</h1>
                    <p class="text-sm text-gray-500 font-medium tracking-wide">#<%= invoiceNumber %>
                    </p>
                </div>
                <div class="flex flex-col items-start md:items-end">
                    <p class="text-sm text-gray-500 mb-1 font-medium">Date Issued</p>
                    <p class="font-semibold text-gray-900">
                        <%= dateIssued %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Billing Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Halasky Information -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">From</h2>
                <div class="space-y-2">
                    <p class="font-bold text-lg text-gray-900 mb-1">HALASKY</p>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 01-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <p class="text-sm text-gray-600">
                            admin@halasky.com
                        </p>
                    </div>

                    <!-- <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        </svg>
                        <p class="text-sm text-gray-600 leading-relaxed">Office 203, Al-Hafeez Heights Gulberg 3, Lahore
                            Pakistan</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <p class="text-sm text-gray-600">+92 344 3333333</p>
                    </div> -->
                </div>
            </div>

            <!-- Client Information -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Billed To</h2>
                <div class="space-y-2">
                    <p class="font-bold text-lg text-gray-900 mb-1">
                        <%= clientName %>
                    </p>
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 01-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <p class="text-sm text-gray-600">
                            <%= clientEmail %>
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <p class="text-sm text-gray-600">
                            <%= clientPhone %>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Passenger Details Section -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6 content-card">
            <div class="p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Passenger Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <% passengers.forEach(p=> { %>
                        <div>
                            <span class="text-sm text-gray-500">Passenger</span>
                            <p class="font-medium text-gray-900">
                                <%= p.firstname %>
                                    <%= p.lastname %>
                            </p>
                            <span class="text-sm text-gray-500">Phone</span>
                            <p class="font-medium text-gray-900">
                                <%= p.phone || '-' %>
                            </p>
                            <span class="inline-block mt-1 text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded">
                                <%= p.type %>
                            </span>
                        </div>
                        <% }) %>
                </div>
            </div>
        </div>

        <!-- Flight Section -->
        <div class="mb-8">
            <div class="rounded-lg shadow-md overflow-hidden mb-4 content-card print-bg-force"
                style="background-color: #203f9c;">
                <div class="p-4">
                    <h2 class="text-lg font-semibold text-white">Flight Information</h2>
                </div>
            </div>

            <!-- Flights Container -->
            <div class="bg-white rounded-lg mb-6">
                <% flights.forEach((flight, index)=> { %>
                    <div class="p-6">
                        <!-- Flight Basic Info -->
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4">
                            <div class="flex-grow">
                                <span class="text-sm text-gray-500 font-medium">Route</span>
                                <p class="font-bold text-gray-900 text-lg mt-1">
                                    <%= flight.origin %> (<%= flight.origin_country %>)
                                            →
                                            <%= flight.destination %> (<%= flight.destination_country %>)
                                </p>

                                <!-- Individual PNR -->
                                <p class="text-sm text-gray-600 mt-2">
                                    PNR:
                                    <span
                                        class="font-semibold <%= flight.booking_status ? 'text-green-600' : 'text-red-600' %>">
                                        <%= flight.pnr || 'Not Booked' %>
                                    </span>
                                </p>
                            </div>

                            <div class="text-right mt-4 md:mt-0">
                                <span class="text-sm text-gray-500 font-medium">Date</span>
                                <p class="font-medium text-gray-900">
                                    <%= new Date(flight.date).toLocaleDateString(undefined, { weekday: 'long' ,
                                        year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                </p>

                                <!-- Individual Amount -->
                                <p class="text-sm text-gray-600 mt-1">
                                    Amount:
                                    <span class="font-semibold text-gray-900">
                                        <%= flight.currency %>
                                            <%= flight.amount.toLocaleString(undefined, { minimumFractionDigits: 2,
                                                maximumFractionDigits: 2 }) %>
                                    </span>
                                </p>
                            </div>
                        </div>

                        <!-- Segments -->
                        <div class="grid grid-cols-1 gap-2">
                            <% flight.segments.forEach(segment=> { %>
                                <div
                                    class="flex flex-col md:flex-row justify-between items-start md:items-center border-t border-gray-100 pt-3">
                                    <div>
                                        <span class="text-[10px] uppercase tracking-wider text-gray-500">Route</span>
                                        <p class="font-bold text-gray-900 text-[11px]">
                                            <%= segment.from_airport %> → <%= segment.to_airport %>
                                        </p>
                                    </div>

                                    <div>
                                        <span class="text-[10px] uppercase tracking-wider text-gray-500">Flight
                                            Code</span>
                                        <p class="font-bold text-gray-900 text-sm">
                                            <%= segment.flight_code %>
                                        </p>
                                    </div>

                                    <div>
                                        <span class="text-[10px] uppercase tracking-wider text-gray-500">Flight
                                            Number</span>
                                        <p class="font-bold text-gray-900 text-sm">
                                            <%= segment.flight_number %>
                                        </p>
                                    </div>

                                    <div>
                                        <span
                                            class="text-[10px] uppercase tracking-wider text-gray-500">Departure</span>
                                        <p class="font-medium text-gray-900 text-xs">
                                            <%= segment.departure_date %>
                                        </p>
                                    </div>

                                    <div>
                                        <span class="text-[10px] uppercase tracking-wider text-gray-500">Arrival</span>
                                        <p class="font-medium text-gray-900 text-xs">
                                            <%= segment.arrival_date %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                    <% if (index < flights.length - 1) { %>
                        <div class="relative flex items-center mx-6">
                            <div class="flex-grow border-t-2" style="border-color: #FCCD26;"></div>
                            <div class="ml-2 text-[#FCCD26]">
                                <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 640 512"
                                    style="height: 1.25rem; width: 1.25rem;" xmlns="http://www.w3.org/2000/svg">
                                    <path
                                        d="M80.55 341.27c6.28 6.84 15.1 10.72 24.33 10.71l130.54-.18a65.62 65.62 0 0 0 29.64-7.12l290.96-147.65c26.74-13.57 50.71-32.94 67.02-58.31 18.31-28.48 20.3-49.09 13.07-63.65-7.21-14.57-24.74-25.27-58.25-27.45-29.85-1.94-59.54 5.92-86.28 19.48l-98.51 49.99-218.7-82.06a17.799 17.799 0 0 0-18-1.11L90.62 67.29c-10.67 5.41-13.25 19.65-5.17 28.53l156.22 98.1-103.21 52.38-72.35-36.47a17.804 17.804 0 0 0-16.07.02L9.91 230.22c-10.44 5.3-13.19 19.12-5.57 28.08l76.21 82.97z">
                                    </path>
                                </svg>
                            </div>
                        </div>
                        <% } %>
                            <% }) %>
            </div>


            <!-- Payment Summary -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8 content-card">
                <div class="p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Payment Summary</h2>
                    <div class="space-y-3">

                        <div class="space-y-3 mb-4">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Base Fare</span>
                                <span class="text-gray-900">
                                    <%= currency %>
                                        <%= totalBaseFare.toLocaleString(undefined, { minimumFractionDigits: 2,
                                            maximumFractionDigits: 2 }) %>
                                </span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Taxes &amp; Fees</span>
                                <span class="text-gray-900">
                                    <%= currency %>
                                        <%= totalTaxAmount.toLocaleString(undefined, { minimumFractionDigits: 2,
                                            maximumFractionDigits: 2 }) %>
                                </span>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-gray-100">
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-bold text-gray-900">Total Amount</span>
                                <span class="text-2xl font-bold" style="color: #203f9c;">
                                    <%= currency %>
                                        <%= totalAmount.toLocaleString(undefined, { minimumFractionDigits: 2,
                                            maximumFractionDigits: 2 }) %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Important Information -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8 content-card">
                <div class="p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Important Information</h2>

                    <!-- Check-in Information (Full Width) -->
                    <div class="flex items-start mb-6 pb-6 border-b border-gray-100">
                        <div class="w-6 h-6 flex items-center justify-center text-primary mt-0.5 mr-3">
                            <i class="ri-time-line"></i>
                        </div>
                        <div>
                            <h3 class="font-medium text-gray-900">Check-in Information</h3>
                            <p class="text-gray-600 text-sm mt-1">Online check-in opens 48 hours before
                                departure. Airport check-in closes 60 minutes before departure. Please
                                arrive at the airport at least 3 hours before your flight.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <div class="flex items-start">
                                <div class="w-6 h-6 flex items-center justify-center text-primary mt-0.5 mr-3">
                                    <i class="ri-passport-line"></i>
                                </div>
                                <div>
                                    <h3 class="font-medium text-gray-900">Travel Documents</h3>
                                    <p class="text-gray-600 text-sm mt-1">Please ensure you have a valid
                                        passport with at least 6 months validity from your return date. Check
                                        visa requirements for your destination.</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-start">
                                <div class="w-6 h-6 flex items-center justify-center text-primary mt-0.5 mr-3">
                                    <i class="ri-file-list-3-line"></i>
                                </div>
                                <div>
                                    <h3 class="font-medium text-gray-900">Cancellation Policy</h3>
                                    <p class="text-gray-600 text-sm mt-1">Cancellations made more than 72 hours
                                        before departure are eligible for a partial refund. Changes to your
                                        booking can be made online or by contacting our customer service.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invoice Footer -->
            <footer class="bg-white border-t border-gray-200 py-6 mt-auto content-card">
                <div class="bg-gray-50 rounded-lg p-6 text-center content-card mb-8">
                    <h2 class="text-lg font-semibold text-gray-900 mb-2">Need Help with Your Booking?</h2>
                    <p class="text-gray-600 mb-4">Our customer service team is available 24/7 to assist you with
                        any
                        questions or concerns.</p>
                    <div class="container mx-auto px-4">
                        <div class="flex flex-wrap justify-center gap-8">
                            <!-- <a href="tel:+18005551234"
                                class="flex items-center text-sm text-gray-600 hover:text-primary transition-colors">
                                <i class="ri-phone-line mr-2 text-primary"></i>
                                +1 (800) 555-1234
                            </a> -->
                            <a href="mailto:support@halasky.com"
                                class="flex items-center text-sm text-gray-600 hover:text-primary transition-colors">
                                <i class="ri-mail-line mr-2 text-primary"></i>
                                support@halasky.com
                            </a>
                            <a href="#"
                                class="flex items-center text-sm text-gray-600 hover:text-primary transition-colors">
                                <i class="ri-chat-1-line mr-2 text-primary"></i>
                                Live Chat
                            </a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
</body>

</html>