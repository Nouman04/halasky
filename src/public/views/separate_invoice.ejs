<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flight Booking Invoice</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e3a8a',
                        secondary: '#fbbf24'
                    },
                    borderRadius: {
                        'none': '0px',
                        'sm': '4px',
                        DEFAULT: '8px',
                        'md': '12px',
                        'lg': '16px',
                        'xl': '20px',
                        '2xl': '24px',
                        '3xl': '32px',
                        'full': '9999px',
                        'button': '8px'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: white;
        }

        @media print {
            .content-card {
                break-inside: avoid;
            }

            body {
                background-color: white;
            }

            .print-bg-force {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>

<body>
    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <header class="bg-white shadow-sm">
            <div class="container mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center">
                    <img src="https://readdy.ai/api/search-image?query=Halasky%20travel%20logo%20with%20blue%20text%20and%20yellow%20accent%2C%20professional%20travel%20company%20logo%2C%20minimalist%20design%2C%20white%20background&width=200&height=60&seq=1&orientation=landscape"
                        alt="Halasky Logo" class="h-10">
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow container mx-auto px-4 py-8">
            <!-- Invoice Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Flight Booking Invoice</h1>
                    <div class="flex items-center mt-2">
                        <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Booking Id: <%= bookingId %>
                        </span>
                    </div>
                    <div>
                        <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <div class="w-4 h-4 flex items-center justify-center mr-1">
                                <i class="ri-check-line"></i>
                            </div>
                            Confirmed
                        </span>
                    </div>
                </div>
            </div>

            <!-- Passenger Details -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6 content-card">
                <div class="p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Passenger Details</h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <% passengers.forEach(p=> { %>
                            <div>
                                <span class="text-sm text-gray-500">Passenger</span>
                                <p class="font-medium text-gray-900">
                                    <%= p.firstname %>
                                        <%= p.lastname %>
                                </p>
                                <span class="text-sm text-gray-500">Phone</span>
                                <p class="font-medium text-gray-900">
                                    <%= p.phone || '-' %>
                                </p>
                                <span class="inline-block mt-1 text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded">
                                    <%= p.type %>
                                </span>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </div>

            <!-- Flight Information Header -->
            <div class="rounded-lg shadow-md overflow-hidden mb-4 content-card print-bg-force"
                style="background-color: #203f9c;">
                <div class="p-4">
                    <h2 class="text-lg font-semibold text-white">Flight Information</h2>
                </div>
            </div>

            <!-- Flights -->
            <% flights.forEach(flight=> { %>
                <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6 content-card">
                    <div class="p-6">
                        <!-- Flight Basic Info -->
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <span class="text-sm text-gray-500">Route</span>
                                <p class="font-medium text-gray-900">
                                    <%= flight.origin %> (<%= flight.origin_country %>)
                                            →
                                            <%= flight.destination %> (<%= flight.destination_country %>)
                                </p>

                                <!-- Individual PNR -->
                                <p class="text-sm text-gray-600 mt-1">
                                    PNR:
                                    <span
                                        class="font-semibold <%= flight.booking_status ? 'text-green-600' : 'text-red-600' %>">
                                        <%= flight.pnr || 'Not Booked' %>
                                    </span>
                                </p>
                            </div>

                            <div class="text-right">
                                <span class="text-sm text-gray-500">Date</span>
                                <p class="font-medium text-gray-900">
                                    <%= new Date(flight.date).toLocaleDateString(undefined, { weekday: 'long' ,
                                        year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                </p>

                                <!-- Individual Amount -->
                                <p class="text-sm text-gray-600 mt-1">
                                    Amount:
                                    <span class="font-semibold text-gray-900">
                                        <%= flight.currency %>
                                            <%= flight.amount.toLocaleString(undefined, { minimumFractionDigits: 2,
                                                maximumFractionDigits: 2 }) %>
                                    </span>
                                </p>
                            </div>
                        </div>

                        <!-- Segments -->
                        <div class="grid grid-cols-1 gap-4">
                            <% flight.segments.forEach(segment=> { %>
                                <div
                                    class="flex flex-col md:flex-row justify-between items-start md:items-center border-t border-gray-200 pt-4">
                                    <div>
                                        <span class="text-sm text-gray-500">Flight Code</span>
                                        <p class="font-medium text-gray-900">
                                            <%= segment.flight_code %>
                                        </p>
                                    </div>

                                    <div>
                                        <span class="text-sm text-gray-500">Flight Number</span>
                                        <p class="font-medium text-gray-900">
                                            <%= segment.flight_number %>
                                        </p>
                                    </div>

                                    <div>
                                        <span class="text-sm text-gray-500">Departure</span>
                                        <p class="font-medium text-gray-900">
                                            <%= segment.departure_date %>
                                        </p>
                                    </div>

                                    <div>
                                        <span class="text-sm text-gray-500">Arrival</span>
                                        <p class="font-medium text-gray-900">
                                            <%= segment.arrival_date %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                </div>
                <% }) %>


                    <!-- Payment Summary -->
                    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8 content-card">
                        <div class="p-6">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4">Payment Summary</h2>
                            <div class="space-y-3">

                                <div class="space-y-3 mb-4">
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Base Fare</span>
                                        <span class="text-gray-900">
                                            <%= currency %>
                                                <%= totalBaseFare.toLocaleString(undefined, { minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2 }) %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Taxes &amp; Fees</span>
                                        <span class="text-gray-900">
                                            <%= currency %>
                                                <%= totalTaxAmount.toLocaleString(undefined, { minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2 }) %>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Total Amount</span>
                                    <span class="font-medium text-gray-900">
                                        <%= currency %>
                                            <%= totalAmount.toLocaleString(undefined, { minimumFractionDigits: 2,
                                                maximumFractionDigits: 2 }) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Important Information -->
                    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8 content-card">
                        <div class="p-6">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4">Important Information</h2>

                            <!-- Check-in Information (Full Width) -->
                            <div class="flex items-start mb-6 pb-6 border-b border-gray-100">
                                <div class="w-6 h-6 flex items-center justify-center text-primary mt-0.5 mr-3">
                                    <i class="ri-time-line"></i>
                                </div>
                                <div>
                                    <h3 class="font-medium text-gray-900">Check-in Information</h3>
                                    <p class="text-gray-600 text-sm mt-1">Online check-in opens 48 hours before
                                        departure. Airport check-in closes 60 minutes before departure. Please
                                        arrive at the airport at least 3 hours before your flight.</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <div class="flex items-start">
                                        <div class="w-6 h-6 flex items-center justify-center text-primary mt-0.5 mr-3">
                                            <i class="ri-passport-line"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-medium text-gray-900">Travel Documents</h3>
                                            <p class="text-gray-600 text-sm mt-1">Please ensure you have a valid
                                                passport with at least 6 months validity from your return date. Check
                                                visa requirements for your destination.</p>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-start">
                                        <div class="w-6 h-6 flex items-center justify-center text-primary mt-0.5 mr-3">
                                            <i class="ri-file-list-3-line"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-medium text-gray-900">Cancellation Policy</h3>
                                            <p class="text-gray-600 text-sm mt-1">Cancellations made more than 72 hours
                                                before departure are eligible for a partial refund. Changes to your
                                                booking can be made online or by contacting our customer service.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <footer class="bg-white border-t border-gray-200 py-6 mt-auto content-card">
                        <div class="bg-gray-50 rounded-lg p-6 text-center content-card mb-8">
                            <h2 class="text-lg font-semibold text-gray-900 mb-2">Need Help with Your Booking?</h2>
                            <p class="text-gray-600 mb-4">Our customer service team is available 24/7 to assist you with
                                any
                                questions or concerns.</p>
                            <div class="container mx-auto px-4">
                                <div class="flex flex-wrap justify-center gap-8">
                                    <a href="tel:+18005551234"
                                        class="flex items-center text-sm text-gray-600 hover:text-primary transition-colors">
                                        <i class="ri-phone-line mr-2 text-primary"></i>
                                        +1 (800) 555-1234
                                    </a>
                                    <a href="mailto:support@halasky.com"
                                        class="flex items-center text-sm text-gray-600 hover:text-primary transition-colors">
                                        <i class="ri-mail-line mr-2 text-primary"></i>
                                        support@halasky.com
                                    </a>
                                    <a href="#"
                                        class="flex items-center text-sm text-gray-600 hover:text-primary transition-colors">
                                        <i class="ri-chat-1-line mr-2 text-primary"></i>
                                        Live Chat
                                    </a>
                                </div>
                            </div>
                        </div>
                    </footer>
        </main>


    </div>
</body>

</html>